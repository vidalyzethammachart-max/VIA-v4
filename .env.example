VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
N8N_WEBHOOK_URL=https://vidalyze.app.n8n.cloud/webhook/google-form-hook
# Upload backend origin. The frontend derives /api/r2-presign-upload from this URL.
VITE_UPLOAD_VIDEO_API_URL=https://YOUR_UPLOAD_BACKEND.example.invalid/api/upload-video
# Optional separate case aggregation backend (local: http://localhost:8080).
# Leave unset to use VITE_UPLOAD_VIDEO_API_URL.
VITE_VIDEO_CASE_API_URL=
# Upload mode: "legacy" sends multipart video through the backend relay, "r2" uploads directly to R2.
VITE_VIDEO_UPLOAD_MODE=r2
CORS_ORIGIN=http://localhost:5173,https://YOUR_FRONTEND.example.invalid
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=86400
# Only the Analyze Video step. Unset preserves the previous OpenAI behavior.
VIDEO_ANALYSIS_PROVIDER=gemini
# Server-only Gemini key from the chosen Google AI Studio project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Qwen alternative; used only with VIDEO_ANALYSIS_PROVIDER=qwen.
# Server-only Model Studio key and matching regional/workspace endpoint.
# Copy the Chat Completions base URL from Model Studio (ending /compatible-mode/v1).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen3.8-omni-flash
# Server-only OpenAI credentials. API usage is billed separately from ChatGPT.
# Existing case aggregation still uses these; it is outside the video-only migration.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AUDIO_MODEL=gpt-audio-mini
# Shared service-to-service token for n8n -> analysis backend. Never put in VITE_*.
# Analysis endpoints fail closed until configured. Use n8n Header Auth credentials.
ANALYSIS_API_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
# Retain this directory on persistent storage for reuse across restarts/deployments.
AI_ANALYSIS_CACHE_DIR=logs/analysis-cache
# Frames are sampled across the complete clip; clamped to 3..12, 1024px wide.
VIDEO_ANALYSIS_FRAME_COUNT=6
# Optional additional trusted HTTPS object-storage hosts; no redirects allowed.
VIDEO_ALLOWED_HOSTS=
# Synthetic local tests only; keep false on deployed services.
VIDEO_ALLOW_LOCAL_TEST_URLS=false
# Server-only values for POST /api/n8n-analysis-result. Do not expose either value with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
N8N_CALLBACK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
