{
  "info": {
    "_postman_id": "4a482074-0ef0-4da7-8549-b6197b5e31ae",
    "name": "VIA V4 - Video Case Test",
    "description": "Run 1-3 to test an individual evaluation. Run 1A, 2A, 2B, and 3A to verify a score 1 plus score 5 aggregate source set before combining in the Video Case UI. Requests 4-6 test callbacks and the separate video case summary identifier contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "supabase_url", "value": "https://YOUR_PROJECT_REF.supabase.co" },
    { "key": "supabase_anon_key", "value": "PASTE_VITE_SUPABASE_ANON_KEY" },
    { "key": "access_token", "value": "PASTE_LOGGED_IN_USER_ACCESS_TOKEN" },
    { "key": "user_id", "value": "PASTE_LOGGED_IN_USER_UUID" },
    { "key": "local_app_url", "value": "http://localhost:5173" },
    { "key": "order_number", "value": "001" },
    { "key": "subject_name", "value": "Postman Test" },
    { "key": "short_code", "value": "pm001" },
    { "key": "member_role", "value": "member" },
    { "key": "video_case_id", "value": "" },
    { "key": "evaluation_id", "value": "" },
    { "key": "aggregate_id", "value": "" },
    { "key": "created_by", "value": "" },
    { "key": "employee_number", "value": "" },
    { "key": "score_test_subject_name", "value": "Postman Score 1-5 Aggregate Test" },
    { "key": "score_test_short_code", "value": "pm-score-15" },
    { "key": "evaluation_id_low", "value": "" },
    { "key": "evaluation_id_high", "value": "" },
    { "key": "n8n_callback_url", "value": "https://via4-app.vercel.app/api/n8n-analysis-result" },
    { "key": "n8n_callback_secret", "value": "PASTE_N8N_CALLBACK_SECRET" },
    { "key": "document_callback_secret", "value": "PASTE_DOCUMENT_CALLBACK_SECRET" }
  ],
  "item": [
    {
      "name": "1. Create or Join Video Case",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"p_order_number\": \"{{order_number}}\",\n  \"p_subject_name\": \"{{subject_name}}\",\n  \"p_short_code\": \"{{short_code}}\",\n  \"p_case_title\": \"{{subject_name}}\",\n  \"p_source_file_name\": null,\n  \"p_video_object_key\": null,\n  \"p_member_role\": \"{{member_role}}\"\n}"
        },
        "url": "{{supabase_url}}/rest/v1/rpc/resolve_video_case_membership"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Video case created or found', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('video_case_id', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1A. Create Score 1-5 Test Case",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"p_order_number\": \"{{order_number}}\",\n  \"p_subject_name\": \"{{score_test_subject_name}}\",\n  \"p_short_code\": \"{{score_test_short_code}}\",\n  \"p_case_title\": \"{{score_test_subject_name}}\",\n  \"p_source_file_name\": null,\n  \"p_video_object_key\": null,\n  \"p_member_role\": \"leader\"\n}"
        },
        "url": "{{supabase_url}}/rest/v1/rpc/resolve_video_case_membership"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Score 1-5 video case created or found', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('video_case_id', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2A. Create Evaluation - All Scores 1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"user_id\": \"{{user_id}}\",\n    \"video_case_id\": \"{{video_case_id}}\",\n    \"order_number\": \"{{order_number}}\",\n    \"subject_name\": \"{{score_test_subject_name}} - คะแนน 1\",\n    \"overall_suggestion\": \"Score 1 aggregate smoke test\",\n    \"rubric\": {\n      \"1\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"2\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"3\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"4\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"5\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"6\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"7\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"8\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 },\n      \"9\": { \"q1\": 1, \"q2\": 1, \"q3\": 1, \"q4\": 1, \"q5\": 1 }\n    },\n    \"analysis_kind\": \"human\",\n    \"document_status\": \"pending\"\n  }\n]"
        },
        "url": "{{supabase_url}}/rest/v1/evaluations"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get('access_token');",
              "const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "pm.collectionVariables.set('user_id', JSON.parse(atob(payload)).sub);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Score 1 evaluation created', () => pm.response.to.have.status(201));",
              "const evaluation = pm.response.json()[0];",
              "pm.collectionVariables.set('evaluation_id_low', String(evaluation.id));",
              "pm.test('Every score 1 section average is 1', () => Object.values(evaluation.section_averages).forEach((value) => pm.expect(value).to.equal(1)));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2B. Create Evaluation - All Scores 5",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"user_id\": \"{{user_id}}\",\n    \"video_case_id\": \"{{video_case_id}}\",\n    \"order_number\": \"{{order_number}}\",\n    \"subject_name\": \"{{score_test_subject_name}} - คะแนน 5\",\n    \"overall_suggestion\": \"Score 5 aggregate smoke test\",\n    \"rubric\": {\n      \"1\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"2\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"3\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"4\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"5\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"6\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"7\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"8\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 },\n      \"9\": { \"q1\": 5, \"q2\": 5, \"q3\": 5, \"q4\": 5, \"q5\": 5 }\n    },\n    \"analysis_kind\": \"human\",\n    \"document_status\": \"pending\"\n  }\n]"
        },
        "url": "{{supabase_url}}/rest/v1/evaluations"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get('access_token');",
              "const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "pm.collectionVariables.set('user_id', JSON.parse(atob(payload)).sub);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Score 5 evaluation created', () => pm.response.to.have.status(201));",
              "const evaluation = pm.response.json()[0];",
              "pm.collectionVariables.set('evaluation_id_high', String(evaluation.id));",
              "pm.test('Every score 5 section average is 5', () => Object.values(evaluation.section_averages).forEach((value) => pm.expect(value).to.equal(5)));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3A. Verify Score 1-5 Sources",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{supabase_url}}/rest/v1/evaluations?id=in.({{evaluation_id_low}},{{evaluation_id_high}})&select=id,video_case_id,subject_name,section_averages"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const low = Number(pm.collectionVariables.get('evaluation_id_low'));",
              "const high = Number(pm.collectionVariables.get('evaluation_id_high'));",
              "if (!Number.isInteger(low) || !Number.isInteger(high)) { throw new Error('Run 2A and 2B before verification.'); }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Both score test evaluations are available', () => pm.expect(pm.response.json()).to.have.length(2));",
              "const rows = pm.response.json();",
              "const low = rows.find((row) => row.id === Number(pm.collectionVariables.get('evaluation_id_low')));",
              "const high = rows.find((row) => row.id === Number(pm.collectionVariables.get('evaluation_id_high')));",
              "pm.test('Score 1 source averages are 1', () => Object.values(low.section_averages).forEach((value) => pm.expect(value).to.equal(1)));",
              "pm.test('Score 5 source averages are 5', () => Object.values(high.section_averages).forEach((value) => pm.expect(value).to.equal(5)));",
              "pm.test('Both sources belong to the same Video Case', () => pm.expect(low.video_case_id).to.equal(high.video_case_id));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Create Evaluation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"user_id\": \"{{user_id}}\",\n    \"video_case_id\": \"{{video_case_id}}\",\n    \"order_number\": \"{{order_number}}\",\n    \"subject_name\": \"{{subject_name}}\",\n    \"overall_suggestion\": \"Test submission from Postman\",\n    \"rubric\": {\n      \"1\": { \"q1\": 5, \"q2\": 4, \"q3\": 4, \"q4\": 5, \"q5\": 4 },\n      \"2\": { \"q1\": 4, \"q2\": 4, \"q3\": 5, \"q4\": 4, \"q5\": 4 },\n      \"3\": { \"q1\": 4, \"q2\": 4, \"q3\": 4, \"q4\": 5, \"q5\": 4 },\n      \"4\": { \"q1\": 5, \"q2\": 4, \"q3\": 4, \"q4\": 4, \"q5\": 5 },\n      \"5\": { \"q1\": 4, \"q2\": 5, \"q3\": 4, \"q4\": 4, \"q5\": 4 },\n      \"6\": { \"q1\": 4, \"q2\": 4, \"q3\": 4, \"q4\": 5, \"q5\": 4 },\n      \"7\": { \"q1\": 5, \"q2\": 4, \"q3\": 4, \"q4\": 4, \"q5\": 4 },\n      \"8\": { \"q1\": 4, \"q2\": 4, \"q3\": 5, \"q4\": 4, \"q5\": 4 },\n      \"9\": { \"q1\": 4, \"q2\": 5, \"q3\": 4, \"q4\": 4, \"q5\": 5 }\n    },\n    \"analysis_kind\": \"human\",\n    \"document_status\": \"pending\"\n  }\n]"
        },
        "url": "{{supabase_url}}/rest/v1/evaluations"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get('access_token');",
              "const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "const claims = JSON.parse(atob(payload));",
              "pm.collectionVariables.set('user_id', claims.sub);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Evaluation created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('evaluation_id', String(pm.response.json()[0].id));",
              "pm.collectionVariables.set('created_by', pm.response.json()[0].created_by || '');",
              "pm.collectionVariables.set('employee_number', pm.response.json()[0].employee_number || '');",
              "pm.test('Section averages were calculated', () => pm.expect(pm.response.json()[0].section_averages).to.not.be.empty);",
              "pm.test('Creator snapshot was saved', () => pm.expect(pm.response.json()[0].created_by).to.match(/^[0-9a-f-]{36}$/i));",
              "pm.test('Employee number was saved', () => pm.expect(pm.response.json()[0].employee_number).to.be.a('string').and.not.be.empty);",
              "pm.test('Evaluation ID was saved', () => pm.expect(pm.collectionVariables.get('evaluation_id')).to.match(/^\\d+$/));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Send Evaluation to n8n",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"evaluation_id\": 0,\n    \"created_by\": \"{{created_by}}\",\n    \"employee_number\": \"{{employee_number}}\",\n    \"order_number\": \"{{order_number}}\",\n    \"subjectName\": \"{{subject_name}}\",\n    \"rubric\": [\n      { \"key\": \"language_and_script\", \"name\": \"Language & Script\", \"scores\": [5, 4, 4, 5, 4] },\n      { \"key\": \"camera_angle\", \"name\": \"Camera Angle\", \"scores\": [4, 4, 5, 4, 4] },\n      { \"key\": \"composition\", \"name\": \"Composition\", \"scores\": [4, 4, 4, 5, 4] },\n      { \"key\": \"narrator\", \"name\": \"Narrator\", \"scores\": [5, 4, 4, 4, 5] },\n      { \"key\": \"story_sequence\", \"name\": \"Story Sequence\", \"scores\": [4, 5, 4, 4, 4] },\n      { \"key\": \"scene_and_location\", \"name\": \"Scene & Location\", \"scores\": [4, 4, 4, 5, 4] },\n      { \"key\": \"lighting\", \"name\": \"Lighting\", \"scores\": [5, 4, 4, 4, 4] },\n      { \"key\": \"audio\", \"name\": \"Audio\", \"scores\": [4, 4, 5, 4, 4] },\n      { \"key\": \"graphics_and_visuals\", \"name\": \"Graphics & Visuals\", \"scores\": [4, 5, 4, 4, 5] }\n    ],\n    \"suggestions\": [\"Test submission from Postman\"],\n    \"overallSuggestionRaw\": \"Test submission from Postman\",\n    \"hasVideo\": false\n  }\n]"
        },
        "url": "{{local_app_url}}/api/n8n-webhook"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const evaluationId = Number(pm.collectionVariables.get('evaluation_id'));",
              "if (!Number.isInteger(evaluationId) || evaluationId <= 0) { throw new Error('Create Evaluation (request 2) must succeed before sending to n8n.'); }",
              "const body = JSON.parse(pm.request.body.raw);",
              "body[0].evaluation_id = evaluationId;",
              "pm.request.body.update(JSON.stringify(body));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('n8n workflow started', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]));",
              "pm.test('Evaluation request uses a positive evaluation_id', () => {",
              "  const body = JSON.parse(pm.request.body.raw);",
              "  pm.expect(body[0].evaluation_id).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Optional - Save AI Result Callback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-n8n-callback-secret", "value": "{{n8n_callback_secret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"evaluation_id\": 0,\n  \"model\": \"gemini-2.5-flash\",\n  \"analysis\": {\n    \"summary\": \"Postman callback test\",\n    \"source\": \"postman\"\n  }\n}"
        },
        "url": "{{n8n_callback_url}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const evaluationId = Number(pm.collectionVariables.get('evaluation_id'));",
              "if (!Number.isInteger(evaluationId) || evaluationId <= 0) { throw new Error('Create Evaluation (request 2) must succeed before testing the callback.'); }",
              "const body = JSON.parse(pm.request.body.raw);",
              "body.evaluation_id = evaluationId;",
              "pm.request.body.update(JSON.stringify(body));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AI callback saved', () => pm.response.to.have.status(200));",
              "pm.test('Callback confirms the evaluation', () => pm.expect(pm.response.json().evaluation.id).to.equal(Number(pm.collectionVariables.get('evaluation_id'))));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Forward Video Case Summary",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_type\": \"video_case_summary\",\n  \"aggregate_id\": \"{{aggregate_id}}\",\n  \"video_case_id\": \"{{video_case_id}}\",\n  \"source_evaluation_ids\": []\n}"
        },
        "url": "{{supabase_url}}/functions/v1/forward-to-n8n"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const aggregateId = pm.collectionVariables.get('aggregate_id') || '';",
              "const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
              "if (!uuidPattern.test(aggregateId)) { throw new Error('Set aggregate_id to a valid video_case_aggregates UUID first.'); }",
              "const body = JSON.parse(pm.request.body.raw);",
              "if (Object.prototype.hasOwnProperty.call(body, 'evaluation_id')) { throw new Error('A summary request must not contain evaluation_id.'); }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Summary forwarding was accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
              "pm.test('Summary request uses aggregate_id only', () => {",
              "  const body = JSON.parse(pm.request.body.raw);",
              "  pm.expect(body.aggregate_id).to.match(/^[0-9a-f-]{36}$/i);",
              "  pm.expect(body).not.to.have.property('evaluation_id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Reject Mixed Summary Identifiers",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supabase_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_type\": \"video_case_summary\",\n  \"aggregate_id\": \"{{aggregate_id}}\",\n  \"evaluation_id\": {{evaluation_id}}\n}"
        },
        "url": "{{supabase_url}}/functions/v1/forward-to-n8n"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const aggregateId = pm.collectionVariables.get('aggregate_id') || '';",
              "const evaluationId = Number(pm.collectionVariables.get('evaluation_id'));",
              "if (!/^[0-9a-f-]{36}$/i.test(aggregateId)) { throw new Error('Set aggregate_id before running the mixed identifier test.'); }",
              "if (!Number.isInteger(evaluationId) || evaluationId <= 0) { throw new Error('Create an evaluation before running the mixed identifier test.'); }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Mixed identifiers are rejected', () => pm.response.to.have.status(400));",
              "pm.test('Error explains the identifier conflict', () => pm.expect(pm.response.json().error).to.include('must not contain both'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
